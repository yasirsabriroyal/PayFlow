# =============================================================================
# PayFlow AP - Environment Variables Template
# =============================================================================
# Copy this file to `.env.local` for local development.
# For production, configure these in Vercel Dashboard > Settings > Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE - Database & Authentication (Required)
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Public URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key for admin operations (Server-side only, NEVER expose to client)
# Required for: Team member invitations, admin operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# APPLICATION URLs (Required for Production)
# -----------------------------------------------------------------------------

# Public URL of your deployed application
# Used for: Auth callbacks, email links, PWA manifest
NEXT_PUBLIC_SITE_URL=https://app.payflow.com

# Alias for app URL (used in notification templates)
NEXT_PUBLIC_APP_URL=https://app.payflow.com

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS - Resend (Optional)
# -----------------------------------------------------------------------------
# Get these from: https://resend.com/api-keys

# API key for sending transactional emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email address
RESEND_FROM_EMAIL=notifications@payflow.com

# -----------------------------------------------------------------------------
# SMS/WHATSAPP NOTIFICATIONS - Twilio (Optional)
# -----------------------------------------------------------------------------
# Get these from: https://console.twilio.com

# Twilio Account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp sender number (Twilio sandbox or registered number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# PAYMENT PROCESSING (Future Integration)
# -----------------------------------------------------------------------------

# Stripe API keys (for future payment gateway integration)
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ACCOUNTING INTEGRATION (Future Integration)
# -----------------------------------------------------------------------------

# QuickBooks Online OAuth credentials
# QUICKBOOKS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# QUICKBOOKS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# QUICKBOOKS_REDIRECT_URI=https://app.payflow.com/api/integrations/quickbooks/callback

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING (Optional)
# -----------------------------------------------------------------------------

# Vercel Analytics (auto-configured on Vercel)
# VERCEL_ANALYTICS_ID=

# Sentry for error tracking
# SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------

# Override Supabase redirect URL for local development
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
